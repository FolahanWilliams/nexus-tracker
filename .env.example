# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── AI (Vercel AI Gateway) ──────────────────────────────────────────────────
# All AI features route through the Vercel AI Gateway (https://vercel.com/docs/ai-gateway).
# On Vercel deployments, auth is automatic via OIDC — nothing to set.
# For local dev, run `vercel env pull .env.local` (provisions VERCEL_OIDC_TOKEN),
# or create an API key in the Vercel dashboard (AI Gateway → API Keys):
# AI_GATEWAY_API_KEY=your-gateway-key
# Optional model overrides (gateway slugs):
# AI_MODEL=google/gemini-3-flash
# AI_SEARCH_MODEL=perplexity/sonar

# ─── Paywall (optional, off by default) ──────────────────────────────────────
# The app is free to use. Set to "true" to re-enable Stripe subscription gating.
# NEXT_PUBLIC_REQUIRE_SUBSCRIPTION=true

# ─── Access Code (optional) ──────────────────────────────────────────────────
# A secret passphrase that grants full access without a Stripe subscription.
# Share this privately with people you want to let in for free.
# Never use NEXT_PUBLIC_ here — this must stay server-side only.
ACCESS_CODE=your-secret-access-code

# ─── Supabase CLI / CI/CD (not needed for local dev) ────────────────────────
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxx
# Project ref: visible in your Supabase project URL (e.g. https://supabase.com/dashboard/project/<ref>)
SUPABASE_PROJECT_REF=your-project-ref
# Database password: set during project creation
SUPABASE_DB_PASSWORD=your-db-password
